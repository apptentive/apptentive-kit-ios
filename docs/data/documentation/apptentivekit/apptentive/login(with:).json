 the"},{"type":"text","text":" "},{"type":"text","text":"initial conversation to an authenticated\/encrypted conversation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before calling this method again, "},{"type":"codeVoice","code":"logOut()"},{"type":"text","text":" must be called."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After logging out, subsequent calls to this method will either resume"},{"type":"text","text":" "},{"type":"text","text":"a conversation that was previously logged out (based on the "},{"type":"codeVoice","code":"sub"},{"type":"text","text":" "},{"type":"text","text":"claim in the JWT), or create a new conversation for a subject that"},{"type":"text","text":" "},{"type":"text","text":"has not previously logged in."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An error if there is a problem logging in."}]}],"name":"Throws"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.apptentive.Apptentive\/documentation\/ApptentiveKit\/Apptentive\/logIn(with:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"ApptentiveKit"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"logIn"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"symbolKind":"method","title":"logIn(with:)","externalID":"s:13ApptentiveKit0A0C5logIn4withySS_tYaKF","role":"symbol","roleHeading":"Instance Method"},"abstract":[{"type":"text","text":"Uses the specified JWT to authenticate a conversation."}],"sections":[],"references":{"doc://com.apptentive.Apptentive/documentation/ApptentiveKit":{"title":"ApptentiveKit","abstract":[],"identifier":"d